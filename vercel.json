{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "snipfilm.vercel.app" }],
      "destination": "https://www.snip.film/:path*",
      "permanent": false
    },
    {
      "source": "/downloads/snip-desktop.pkg",
      "destination": "https://github.com/danielosagie/snip/releases/latest/download/snip-desktop.pkg",
      "permanent": false
    },
    {
      "source": "/downloads/snip-desktop.dmg",
      "destination": "https://github.com/danielosagie/snip/releases/latest/download/snip-desktop.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/snip-desktop-x64.dmg",
      "destination": "https://github.com/danielosagie/snip/releases/latest/download/snip-desktop-x64.dmg",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/:path*", "destination": "/_shell.html" }]
}
