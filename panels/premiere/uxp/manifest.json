{
  "manifestVersion": 5,
  "id": "com.snip.premiere.panel",
  "name": "Snip Premiere",
  "version": "0.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "snipTimelinePanel",
      "label": {
        "default": "Snip"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 700
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://your-deployment.convex.site"
      ]
    }
  }
}
